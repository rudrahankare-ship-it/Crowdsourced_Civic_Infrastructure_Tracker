# MongoDB Atlas. Copy this file to .env and replace the URI with your cluster URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=civicsignal

# Optional corporation employee portal. Choose a private admin email and a unique password of 8 to 128 characters.
# These values create/update the corporation administrator account at backend startup.
CIVICSIGNAL_ADMIN_EMAIL=rudrahankare2006@gmail.com
CIVICSIGNAL_ADMIN_NAME=Corporation Employee
CIVICSIGNAL_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Optional municipal email forwarding. Without these, submitted reports are stored with status "queued".
MUNICIPAL_EMAIL=reports@your-municipality.gov
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=civicsignal@example.com
SMTP_TLS=true
